# XEI Emotion Intelligence — environment template
# Copy to .env and fill in values. Never commit .env.

# API
APP_NAME=XEI Emotion Intelligence
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Supabase (placeholders)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (optional direct URL; prefer Supabase client in most cases)
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# Observability / logging
LOG_LEVEL=INFO
